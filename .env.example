# Google Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Admin Email / Webhook for New User Registration Notifications
VITE_NOTIFICATION_ADMIN_EMAIL=your_admin_email@gmail.com
VITE_NOTIFICATION_API_ENDPOINT=/api/notify-signup

# Gmail App Password (16 characters)
GMAIL_USER=your_admin_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
